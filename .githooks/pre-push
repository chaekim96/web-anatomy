#!/bin/sh
# Rebuild before pushing. Abort if the build fails or changes any files,
# so a stale ?v= fingerprint never reaches main.
cd "$(git rev-parse --show-toplevel)" || exit 1

if ! node scripts/build.mjs; then
  echo "pre-push: build failed, push aborted." >&2
  exit 1
fi

changed=$(git status --porcelain)
if [ -n "$changed" ]; then
  echo "pre-push: the build updated files, push aborted:" >&2
  echo "$changed" >&2
  echo "Commit these changes, then push again." >&2
  exit 1
fi
